# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Server-side AI. Store this in the Convex deployment environment for runtime;
# .env.local is only for secure local tooling and must never be committed.
OPENAI_API_KEY=
ATLAS_OPENAI_MODEL=gpt-5.4-mini

# @convex-dev/auth (set on Convex deployment by provisioning pipeline)
# JWT_PRIVATE_KEY=
# JWKS=
# CONVEX_SITE_URL=

# Admin API Access
ADMIN_TOKEN_SECRET=

# Platform Integration
NEXT_PUBLIC_PLATFORM_URL=
PLATFORM_FULFILLMENT_SECRET=
ATLAS_SUBSCRIPTION_WEBHOOK_SECRET=
