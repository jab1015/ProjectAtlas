# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Server-side AI. Store these in the Convex deployment environment for runtime;
# .env.local is only for secure local tooling and must never be committed.
OPENAI_API_KEY=
ATLAS_OPENAI_MODEL=gpt-5.4-mini
# Optional: use a separate model for Stage 2 validation. Blank inherits ATLAS_OPENAI_MODEL.
ATLAS_VALIDATION_MODEL=

# @convex-dev/auth (set on Convex deployment by provisioning pipeline)
# JWT_PRIVATE_KEY=
# JWKS=
# CONVEX_SITE_URL=
# Password reset email provider. Store in the Convex deployment environment.
AUTH_RESEND_KEY=
# Optional verified sender. Example: InventSmith <support@yourdomain.com>
AUTH_EMAIL=

# Legacy external admin/API access. Browser /admin access now uses Convex auth + role checks.
ADMIN_TOKEN_SECRET=

# Platform Integration
NEXT_PUBLIC_PLATFORM_URL=
PLATFORM_FULFILLMENT_SECRET=
ATLAS_SUBSCRIPTION_WEBHOOK_SECRET=
